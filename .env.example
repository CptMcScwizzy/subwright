# Copy to .env and adjust. Only TAG and the paths normally need changing -
# everything else can be set from the Settings page once it is running.

# Pin an exact version. Never use `latest`: rolling back should be editing this
# one line, and `latest` makes "what is actually deployed?" unanswerable.
SUBWRIGHT_TAG=v0.1.0

# Host folder containing ingest/ and reprocess/. Mounted at the SAME path inside
# the container, so paths shown in the UI can be pasted into a host shell.
WATCH_DIR=/mnt/data/translate

TZ=America/Phoenix

# Seed values for the first run. After that the Settings page is the source of
# truth and these are ignored.
SW_LANGUAGE=ja
SW_MODEL=large-v3

# cuda means "fail loudly if the GPU is unavailable" rather than silently
# running 20-50x slower on the CPU.
SW_DEVICE=cuda

# int8 is correct for GTX 10-series (compute 6.1): no tensor cores, and float16
# runs at 1/64 of float32 there.
SW_COMPUTE_TYPE=int8

# Host port for the web UI. Configurable so an override file can MOVE it -
# Compose concatenates port lists when merging, so an override that simply
# names a second port would publish both.
SW_PUBLISH_PORT=8420

# Use a locally built image instead of the published one. Leave unset in
# normal operation; set it when testing a build that has not been released.
#SUBWRIGHT_IMAGE=subwright:dev
